{
  "description": "Load the branch's thread at session start and after compaction, and tell compaction what to keep.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/threads.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/threads.py\" pre-compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
